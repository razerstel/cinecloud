# Database (SQLite, archivo local)
DATABASE_URL="file:./dev.db"

# Auth.js
# Genera el secret con: openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# TMDB (https://www.themoviedb.org/settings/api)
# Acepta token v4 (Bearer) o api_key v3. Si es v4 el cliente lo usa como Bearer.
TMDB_API_KEY=""

# Endpoints (no cambiar salvo necesidad)
TMDB_BASE_URL="https://api.themoviedb.org/3"
TMDB_IMG_BASE_URL="https://image.tmdb.org/t/p"
VIDSRC_BASE_URL="https://vidsrc-embed.ru"
